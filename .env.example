# This file configures a native server and the compose variables. Docker
# Compose reads the container settings from infra/env/*.env and the secrets
# from files in SECRETS_DIR; see the header of infra/docker-compose.yml.
# Any secret below can come from a private file instead: set NAME_FILE to its
# path (owner-only permissions), never both NAME and NAME_FILE.

# Docker Compose: absolute host directory with the secret files.
SECRETS_DIR=/absolute/path/to/secrets

# Server database role. The server only reads and writes rows: use the role
# from infra/app-role.sql. The owner role runs --installation-init and
# --migrate, which applies a release's migrations before the server starts.
# A remote database needs sslmode=verify-full. On a private container network
# set DATABASE_NETWORK=private to also allow disable, require or verify-ca.
DATABASE_URL=postgresql://estaciona_app:yourAppRolePassword@127.0.0.1:5432/estaciona_ai

# Forecast worker (in gateway/: python -m ml.worker), run next to the server.
# Read-only role from infra/forecast-reader.sql; never the server's DATABASE_URL.
ML_DATABASE_URL=postgresql://estaciona_forecast_reader:yourForecastReaderPassword@127.0.0.1:5432/estaciona_ai
# Same TLS rule as the server; ML_DATABASE_NETWORK=private for a container network.
# Its own edge credential: --edge-create NAME --secret-file PATH, then
# --edge-policy ID FILE with {"path_update":false,"trend_prediction":true,"cameras":[]}.
FORECAST_EDGE_API_KEY=yourForecastCredentialFromSecretFile
# Optional forecast site profile (JSON): timezone, expected cars per shift,
# academic periods and local holidays. Unset uses a generic campus.
# FORECAST_PROFILE=/absolute/path/to/installation/forecast_profile.json

# WS
SERVER_WS_URL=wss://api.estaciona.tech/ws/edge
LOCAL_WS_URL=ws://localhost:8001/ws/edge
GATEWAY_PORT=8001

# Security: at least 32 random bytes each (openssl rand -base64 48).
JWT_SECRET=yourSuperSecretJwtSecretKeyOfAtLeast32Bytes
PLATE_SECRET_PEPPER=yourSuperSecretPepperOfAtLeast32Bytes
# Personal data keys (AES-256-GCM), one "<id>:<base64 of 32 bytes>" per line;
# the highest id encrypts. Create with:
#   printf '1:%s\n' "$(openssl rand -base64 32)" > personal-data.keys
# Keep it out of the database host's backups, and back it up separately:
# losing it loses the encrypted fields. Owner-only permissions are required.
# Docker Compose mounts SECRETS_DIR/personal_data_keys into the server only.
PERSONAL_DATA_KEYS_FILE=/absolute/path/to/personal-data.keys
# Per-gateway credential issued by the server:
#   --edge-create NAME --secret-file PATH (rotate with --edge-rotate).
EDGE_API_KEY=yourGatewayCredentialFromSecretFile
# Optional: unacknowledged events in flight per cloud connection (1-8, default 8).
EDGE_MAX_IN_FLIGHT=8

# Sign-in through the central identity provider (infra/identity). Register the
# installation with tools/identity/provision.py installation-create; it writes
# the client secret to a private file for OIDC_CLIENT_SECRET_FILE.
OIDC_ISSUER_URL=https://auth.example.com/realms/estaciona
OIDC_CLIENT_ID=uniube-centro
OIDC_CLIENT_SECRET_FILE=/absolute/path/to/oidc-client.secret
# Exactly the callback registered for the client.
OIDC_REDIRECT_URL=https://api.example.com/auth/callback
# Where the browser lands after sign-in; return paths are appended to it.
APP_URL=https://app.example.com

# Browser apps of this installation: exact HTTP(S) origins, comma-separated, no
# path or trailing slash. They get CORS with credentials, may write with the
# session cookie and open WebSockets. The server refuses to start without it.
WS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# Optional license plate module (true/false, default false). Refused in
# production: plates are not collected in this release.
LPR_ENABLED=false

# Installation (required)
# Absolute host directory containing installation.json, config.json,
# spots_3d.json and the optional reservation_policy.json.
# Docker mounts this at /deployment; native server uses the same host directory.
SITE_DATA_DIR=/absolute/path/to/installation/maps
API_DOMAIN=api.example.com

# Vision input: external maps and video/RTSP source, one camera per process.
VISION_STREAM_URL=rtsp://camera.example.invalid/stream
VISION_SPOTS_PATH=/absolute/path/to/installation/spots.json
VISION_CAMERA_ID=cam_01
VISION_MODEL_PATH=/absolute/path/to/models/rtdetr-hgnetv2-l.onnx
# GPU libraries: cd vision && uv sync --extra cuda. CPU must be selected explicitly.
VISION_DEVICE=cuda
