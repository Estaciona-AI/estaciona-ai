{
  "$defs": {
    "ExportedReservation": {
      "properties": {
        "completed_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "spot_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "spot_id",
        "status",
        "created_at",
        "expires_at",
        "completed_at"
      ],
      "type": "object"
    },
    "ExportedSession": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "revoked_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "created_at",
        "expires_at",
        "revoked_at"
      ],
      "type": "object"
    },
    "ExportedVisit": {
      "properties": {
        "occupied_at": {
          "format": "date-time",
          "type": "string"
        },
        "released_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "spot_id": {
          "type": "string"
        }
      },
      "required": [
        "spot_id",
        "occupied_at",
        "released_at"
      ],
      "type": "object"
    },
    "UserResponse": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "date_of_birth": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "pcd_status": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "username": {
          "description": "Generated by the identity provider; carries no personal data.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "username",
        "display_name",
        "date_of_birth",
        "pcd_status",
        "role",
        "created_at"
      ],
      "type": "object"
    }
  },
  "$id": "urn:estaciona-ai:rest:personal-data-export:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Everything this installation keeps about the signed-in person, decrypted.\nE-mail and password live only at the identity provider.",
  "properties": {
    "account": {
      "$ref": "#/$defs/UserResponse"
    },
    "occupancy_history": {
      "items": {
        "$ref": "#/$defs/ExportedVisit"
      },
      "type": "array"
    },
    "reservations": {
      "items": {
        "$ref": "#/$defs/ExportedReservation"
      },
      "type": "array"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/ExportedSession"
      },
      "type": "array"
    }
  },
  "required": [
    "account",
    "reservations",
    "occupancy_history",
    "sessions"
  ],
  "title": "PersonalDataExport",
  "type": "object",
  "x-contract-version": "2.0.0"
}
