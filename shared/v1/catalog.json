  "installation_configuration": {
    "files": [
      "installation.json",
      "config.json",
      "spots_3d.json",
      "reservation_policy.json"
    ],
    "optional_files": [
      "reservation_policy.json"
    ],
    "public_endpoint": null,
    "scope_from_client_payload": false,
    "secrets_source": "process_environment_or_private_files",
    "source": "operator_package"
  },
  "local_transport": {
    "ack_boundary": "gateway_sqlite_commit",
    "authentication": "local_shared_key",
    "cloud_credential_reused": true,
    "endpoint_source": "gateway_process_configuration",
    "legacy_unwrapped_events_accepted": true,
    "negotiation_header": {
      "X-Estaciona-Local-Delivery": "1"
    },
    "receive": {
      "schema": "v1/vision-to-gateway.schema.json"
    },
    "send": {
      "schema": "v1/gateway-to-vision.schema.json"
    },
    "trust_boundary": "vision_and_gateway_share_credentials"
  },
  "schema_null_meaning": "no_exported_dto_schema",
  "scope": "single_installation_per_process_and_database",
  "sign_in": {
    "accounts": "provisioned_at_identity_provider",
    "backchannel_logout": "/auth/backchannel-logout",
    "callback": "/auth/callback",
    "identity_provider": "central_keycloak_realm",
    "local_credentials": false,
    "protocol": "openid_connect_authorization_code_with_pkce",
    "session": "host_only_http_only_cookie",
    "start": "/auth/login"
  },
  "version": "1.4.0",
  "websockets": [
    {
      "authentication": "single_use_ticket",
      "authorization": "authenticated_user",
      "delivery": "best_effort_disconnect_requires_resnapshot",
      "id": "app",
      "initial_state": "active_spots",
      "path": "/ws/app",
      "receive": {
        "schema": "v1/app-to-server.schema.json"
      },
      "send": {
        "schema": "v1/server-to-app.schema.json"
      },
      "ticket_destination": "app"
    },
    {
      "authentication": "single_use_ticket",
      "authorization": "admin",
      "delivery": "best_effort_disconnect_requires_resnapshot",
      "id": "dashboard",
      "initial_state": "active_spots_and_cached_forecast_if_available",
      "path": "/ws/dashboard",
      "receive": null,
      "send": {
        "schema": "v1/server-to-app.schema.json"
      },
      "ticket_destination": "dashboard"
    },
    {
      "ack_boundary": "postgres_commit",
      "authentication": "individual_gateway_bearer",
      "authorization": "explicit_gateway_grants",
      "event_authorization": {
        "CAR_DETECTED": "lpr_enabled_camera_operation_and_granted_spots",
        "PATH_UPDATE": "installation_wide_explicit_permission",
        "SPOT_UPDATE": "camera_spot_pair_and_operation",
        "TREND_PREDICTION": "installation_wide_explicit_permission",
        "TREND_PREDICTION_V2": "installation_wide_explicit_permission"
      },
      "id": "edge",
      "legacy_events_have_durable_ack": false,
      "legacy_unwrapped_events_accepted": true,
      "path": "/ws/edge",
      "payload": {
        "schema": "v1/edge-events.schema.json"
      },
      "receive": {
        "schema": "v1/gateway-to-server.schema.json"
      },
      "send": {
        "schema": "v1/server-to-gateway.schema.json"
      }
    }
  ]
}
