# Keycloak container only.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me
# Temporary master-realm administrator for the first sign-in; replace it with a
# permanent administrator with MFA and remove these two lines.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Values for the first realm import (realm/estaciona.json).
# The hub (Estaciona-AI/web) sign-in return page and its origin.
HUB_REDIRECT_URI=https://estaciona.tech/entrar/
HUB_ORIGIN=https://estaciona.tech
# Secret of the provisioner service account used by tools/identity/provision.py.
# Generate with: openssl rand -base64 48. Store it for the tool in a private file.
PROVISIONER_CLIENT_SECRET=change-me
