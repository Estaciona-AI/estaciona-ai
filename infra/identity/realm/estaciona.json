{
  "realm": "estaciona",
  "enabled": true,
  "displayName": "Estaciona AI",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(3) and hashAlgorithm(argon2)",
  "defaultSignatureAlgorithm": "EdDSA",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "eddsa-generated",
        "providerId": "eddsa-generated",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "eddsaEllipticCurveKey": ["Ed25519"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "hub",
      "name": "Estaciona AI",
      "description": "Site entry point: finds the installations of the account and redirects.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": ["${HUB_REDIRECT_URI}"],
      "webOrigins": ["${HUB_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HUB_ORIGIN}/"
      },
      "protocolMappers": [
        {
          "name": "installation roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provisioner",
      "name": "Provisioning tool",
      "description": "tools/identity/provision.py: installation clients and invited accounts.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROVISIONER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-provisioner",
      "enabled": true,
      "serviceAccountClientId": "provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-clients",
          "view-clients",
          "query-clients",
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
