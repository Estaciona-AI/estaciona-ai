# Server settings that are not secrets. Secrets are files in SECRETS_DIR.
# Browser apps of this installation: exact HTTP(S) origins, comma-separated.
WS_ALLOWED_ORIGINS=https://app.example.com
# Central identity provider; the client secret is SECRETS_DIR/oidc_client_secret.
OIDC_ISSUER_URL=https://auth.example.com/realms/estaciona
OIDC_CLIENT_ID=uniube-centro
OIDC_REDIRECT_URL=https://api.example.com/auth/callback
APP_URL=https://app.example.com
# Refused in production: plates are not collected in this release.
LPR_ENABLED=false
# Optional WebSocket admission (defaults shown). Handshakes that query the
# database at once (keep it below the pool of 5), and open sockets per kind.
# WS_HANDSHAKE_CONCURRENCY=2
# WS_MAX_EDGE_CONNECTIONS=64
# WS_MAX_APP_CONNECTIONS=2000
# WS_MAX_DASHBOARD_CONNECTIONS=64
