# Database container only. POSTGRES_USER is the container superuser, for
# maintenance only. On the first start, db-init creates estaciona_owner (no
# superuser powers, owner of this database) with ESTACIONA_OWNER_PASSWORD; that
# role runs --installation-init, --migrate and infra/app-role.sql, and the
# running server uses estaciona_app from infra/app-role.sql.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estaciona
ESTACIONA_OWNER_PASSWORD=change-me-too
# Password of estaciona_app, the role in the server's database_url secret.
ESTACIONA_APP_PASSWORD=change-me-three
